{
  "text-color": "#1C1C1C",
  "background-color": "#F4F6F8",
  "line-number-color": "#8A94A0",
  "line-number-background-color": null,
  "text-styles": {
    "Keyword":        { "text-color": "#1B4F72", "bold": true },
    "ControlFlow":    { "text-color": "#1B4F72", "bold": true },
    "DataType":       { "text-color": "#5B3E8E" },
    "BuiltIn":        { "text-color": "#5B3E8E" },
    "Function":       { "text-color": "#1C1C1C" },
    "Comment":        { "text-color": "#6B7785", "italic": true },
    "Documentation":  { "text-color": "#6B7785", "italic": true },
    "String":         { "text-color": "#2E7D32" },
    "Char":           { "text-color": "#2E7D32" },
    "SpecialString":  { "text-color": "#2E7D32" },
    "VerbatimString": { "text-color": "#2E7D32" },
    "DecVal":         { "text-color": "#B7791F" },
    "BaseN":          { "text-color": "#B7791F" },
    "Float":          { "text-color": "#B7791F" },
    "Constant":       { "text-color": "#B7791F" },
    "Attribute":      { "text-color": "#B7791F" },
    "Variable":       { "text-color": "#1C1C1C" },
    "Operator":       { "text-color": "#1C1C1C" },
    "Preprocessor":   { "text-color": "#B7791F" },
    "Import":         { "text-color": "#1B4F72" },
    "Other":          { "text-color": "#1C1C1C" },
    "Error":          { "text-color": "#B00020", "bold": true },
    "Alert":          { "text-color": "#B00020", "bold": true },
    "Warning":        { "text-color": "#B7791F" },
    "Annotation":     { "text-color": "#6B7785" },
    "Information":    { "text-color": "#6B7785" },
    "Extension":      { "text-color": "#1C1C1C" },
    "Normal":         { "text-color": "#1C1C1C" }
  }
}

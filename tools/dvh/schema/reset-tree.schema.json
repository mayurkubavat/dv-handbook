{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayurkubavat.github.io/dv-handbook/schema/reset-tree-1.json",
  "title": "dvh reset-tree",
  "description": "Each register's reset, and the registers with none.",
  "type": "object",
  "required": [
    "registers",
    "no_reset"
  ],
  "additionalProperties": false,
  "properties": {
    "registers": {
      "description": "Register name -> the reset that drives it.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "active",
          "sources",
          "through",
          "controls",
          "src"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "description": "What forces the register, and when.",
            "$comment": "A set or a load is not a reset and is not called one.",
            "enum": [
              "asynchronous",
              "synchronous",
              "asynchronous set",
              "asynchronous load"
            ]
          },
          "active": {
            "description": "The level at which this reset asserts.",
            "enum": [
              "high",
              "low"
            ]
          },
          "sources": {
            "description": "Sorted roots of the reset net.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "through": {
            "description": "Cells walked through on the way there.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "controls": {
            "description": "Every forcing control the register carries.",
            "$comment": "A register can have two: a set and a clear.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["pin", "kind", "active", "sources", "through"],
              "additionalProperties": false,
              "properties": {
                "pin": {
                  "description": "The cell pin it arrives on.",
                  "type": "string"
                },
                "kind": {
                  "description": "What it does, and when.",
                  "type": "string"
                },
                "active": {
                  "description": "The level that asserts it.",
                  "enum": ["high", "low"]
                },
                "sources": {
                  "description": "Sorted roots the control traces back to.",
                  "type": "array",
                  "items": {"type": "string"}
                },
                "through": {
                  "description": "Cells and gating the walk passed.",
                  "type": "array",
                  "items": {"type": "string"}
                }
              }
            }
          },
          "src": {
            "description": "Source location, as file:line.col-line.col.",
            "$comment": "Constrained so a blank or a non-location cannot pass.",
            "type": "string",
            "pattern": "^[^:]+:\\d+"
          }
        }
      }
    },
    "no_reset": {
      "description": "Registers with no reset pin, sorted by name.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "src"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "The register's name.",
            "type": "string"
          },
          "src": {
            "description": "Source location, as file:line.col-line.col.",
            "$comment": "Constrained so a blank or a non-location cannot pass.",
            "type": "string",
            "pattern": "^[^:]+:\\d+"
          }
        }
      }
    }
  },
  "$comment": "A register in `no_reset` is a finding, not a bug."
}

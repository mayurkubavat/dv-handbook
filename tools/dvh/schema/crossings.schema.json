{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayurkubavat.github.io/dv-handbook/schema/crossings-1.json",
  "title": "dvh crossings",
  "description": "Crossings between clock domains, and their shapes.",
  "type": "object",
  "required": [
    "crossings",
    "unrecognized"
  ],
  "additionalProperties": false,
  "$defs": {
    "crossing": {
      "type": "object",
      "required": [
        "to",
        "to_domain",
        "from",
        "from_domain",
        "width",
        "direct",
        "second_stage",
        "shape_recognized",
        "note",
        "src"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "The sending register.",
          "type": "string"
        },
        "from_domain": {
          "description": "Its clock domain.",
          "type": "string"
        },
        "to": {
          "description": "The receiving register.",
          "type": "string"
        },
        "to_domain": {
          "description": "Its clock domain.",
          "type": "string"
        },
        "width": {
          "description": "Width of the receiving register, in bits.",
          "type": "integer",
          "minimum": 1
        },
        "direct": {
          "description": "True if the sender reaches D with no logic between.",
          "type": "boolean"
        },
        "second_stage": {
          "description": "Same-domain registers fed directly by this one.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "src": {
          "description": "Source location, as file:line.col-line.col.",
          "$comment": "Constrained so a blank or a non-location cannot pass.",
          "type": "string",
          "pattern": "^[^:]+:\\d+"
        },
        "shape_recognized": {
          "description": "True if this matches a known shape.",
          "type": "boolean",
          "$comment": "Two-flop, and not one of several carrying one value."
        },
        "note": {
          "description": "Empty when known; else what was seen.",
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "crossings": {
      "description": "Every crossing found, safe or not.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/crossing"
      }
    },
    "unrecognized": {
      "description": "The subset to review.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/crossing"
      },
      "$comment": "A shape to look at, not a bug."
    }
  },
  "$comment": "Reports a shape, never a verdict about safety."
}

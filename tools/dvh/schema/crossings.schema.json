{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayurkubavat.github.io/dv-handbook/schema/crossings-1.json",
  "title": "dvh crossings",
  "description": "Crossings between domains. No verdict is a sign-off.",
  "type": "object",
  "required": [
    "crossings",
    "unsynchronized"
  ],
  "additionalProperties": false,
  "$defs": {
    "crossing": {
      "type": "object",
      "required": [
        "to",
        "to_domain",
        "from",
        "from_domain",
        "width",
        "direct",
        "second_stage",
        "synchronized",
        "reason",
        "src"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "The sending register.",
          "type": "string"
        },
        "from_domain": {
          "description": "Its clock domain.",
          "type": "string"
        },
        "to": {
          "description": "The receiving register.",
          "type": "string"
        },
        "to_domain": {
          "description": "Its clock domain.",
          "type": "string"
        },
        "width": {
          "description": "Width of the receiving register, in bits.",
          "type": "integer",
          "minimum": 1
        },
        "direct": {
          "description": "True if the sender reaches D with no logic between.",
          "type": "boolean"
        },
        "second_stage": {
          "description": "Same-domain registers fed directly by this one.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "synchronized": {
          "description": "True only for a recognized synchronizer shape.",
          "type": "boolean",
          "$comment": "Direct, feeds a second stage, one bit, not one of many."
        },
        "reason": {
          "description": "Empty when synchronized; else why not, for a person.",
          "type": "string"
        },
        "src": {
          "description": "Source location, as file:line.col-line.col.",
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "crossings": {
      "description": "Every crossing found, safe or not.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/crossing"
      }
    },
    "unsynchronized": {
      "description": "The subset to act on.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/crossing"
      },
      "$comment": "A build gate fails when this is not empty."
    }
  },
  "$comment": "A shape never taught is reported unsynchronized."
}

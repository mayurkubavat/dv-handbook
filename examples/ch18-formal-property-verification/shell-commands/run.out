tool: informal 0.1.0; one session, 42 commands
== Reading a design
  clear -all
      runs: accepted; returns nothing
  analyze -sv12 bmc-depth/deep.sv
      runs: accepted; returns nothing
  elaborate -top deep -parameter BUG 16
      runs: 1 property more; returns deep
  get_design_info
      runs: returns top deep files 1 clocks 0 props 1
== Clock and reset
  clock clk
      runs: accepted; returns nothing
  reset -expression {rst}
      runs: accepted; returns nothing
== Properties from the script
  assert -name a_step {!en |=> $stable(cnt)}
      runs: 1 property more; returns a_step
  assume -name m_slow {en |=> !en}
      runs: 1 property more; returns m_slow
  cover -name c_three {cnt == 16'd3}
      runs: 1 property more; returns c_three
  include extra.tcl
      runs: 1 property more; returns c_five
  get_property_list
      runs: returns deep.a_never a_step m_slow c_three c_five
  get_property_list -include {type cover}
      runs: returns c_three c_five
== Proving
  set_prove_time_limit 5s
      runs: accepted; returns nothing
  set_prove_time_limit 500ms
      error: bad time unit in '500ms'
  informal::set_engines informal-kind
      runs: accepted; returns nothing
  prove -all
      runs: prints the property table; returns the counts proven 1 cex 1 covered 2 unreachable 0 undetermined 0 error 0
  prove -property deep.a_never
      runs: prints the property table; returns the counts proven 0 cex 1 covered 0 unreachable 0 undetermined 0 error 0
  prove -property a_never
      error: no property matches 'a_never'
  prove -bg -all
      ignored: says: prove: ignoring -bg (vendor engine/GUI option); prints the property table; returns the counts proven 1 cex 1 covered 2 unreachable 0 undetermined 0 error 0
  set_engine_mode {Ht}
      runs: accepted; returns nothing
== Results
  get_status a_step
      runs: returns proven
  get_status deep.a_never
      runs: returns cex
  get_property_list -include {status covered}
      runs: returns c_three c_five
  report
      runs: prints the property table; returns several lines of text
  informal::session
      runs: returns several lines of text
  visualize -violation -property deep.a_never
      error: visualize: the waveform UI is not available yet (phase 1 UI v1)
== Changing the problem
  assume -disable m_slow
      runs: accepted; returns nothing
  assume -enable m_slow
      runs: accepted; returns nothing
  assert -disable deep.a_never
      runs: accepted; returns nothing
  assert -enable deep.a_never
      runs: accepted; returns nothing
  assume -remove m_slow
      runs: 1 property fewer
  assert -env {en}
      runs: 1 property more; returns assume_0
  stopat cnt
      runs: accepted; returns nothing
  stopat -list
      runs: returns cnt
  stopat -clear
      runs: accepted; returns nothing
  set_lowering
      runs: returns skip_initial_checks off isunknown_is_false off
  task -create t1
      ignored: says: task -create t1: tasks are not modelled yet; properties stay in one task
  get_version
      error: invalid command name "get_version"
== A design with a black box
  clear -all
      runs: 5 properties fewer
  analyze -sv12 over-constraint/handshake.sv
      runs: accepted; returns nothing
  elaborate -top handshake -bbox_m {timer}
      runs: returns handshake
  get_property_list
      runs: accepted; returns nothing
